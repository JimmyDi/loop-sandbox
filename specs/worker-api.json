{
  "components": {
    "schemas": {
      "BrowserAction": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "open",
              "set_content",
              "snapshot",
              "click",
              "fill",
              "screenshot"
            ],
            "title": "Action",
            "type": "string"
          },
          "selector": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selector"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 1000000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 8192,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "action"
        ],
        "title": "BrowserAction",
        "type": "object"
      },
      "Command": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "maxLength": 16000,
            "minLength": 1,
            "title": "Command",
            "type": "string"
          },
          "timeout": {
            "default": 30,
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Timeout",
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "title": "Command",
        "type": "object"
      },
      "FileEdit": {
        "additionalProperties": false,
        "properties": {
          "new_text": {
            "maxLength": 1000000,
            "title": "New Text",
            "type": "string"
          },
          "old_text": {
            "maxLength": 1000000,
            "minLength": 1,
            "title": "Old Text",
            "type": "string"
          },
          "path": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "old_text",
          "new_text"
        ],
        "title": "FileEdit",
        "type": "object"
      },
      "FileWrite": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 1000000,
            "title": "Content",
            "type": "string"
          },
          "path": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "title": "FileWrite",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProcessCommand": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "maxLength": 16000,
            "minLength": 1,
            "title": "Command",
            "type": "string"
          },
          "cwd": {
            "default": ".",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Cwd",
            "type": "string"
          },
          "timeout": {
            "default": 300,
            "maximum": 1800.0,
            "minimum": 1.0,
            "title": "Timeout",
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "title": "ProcessCommand",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
